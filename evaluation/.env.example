# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY="sk-..."

# Paper settings
MODEL="gpt-4o-mini"                      # memory extraction + answer generation
EMBEDDING_MODEL="text-embedding-3-small"

# Local OSS Mem0 storage (Qdrant on disk + SQLite history)
MEM0_STORE_DIR="mem0_store_obsdate"
MEM0_COLLECTION="locomo"
MEM0_TELEMETRY="False"
